{
  "name": "curriculum-vitae-site",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "prebuild": "pnpm run compile && rm -rf dist/_includes && cp -r src/_includes/. dist/_includes && cp src/index.njk dist/index.njk && mv dist/_data/cv.js dist/_data/cv.cjs",
    "compile": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ."
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.0",
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20250911.1"
  }
}
